# Random secret for signing logins. Generate with: npx auth secret
# (Optional: if empty, one is derived from the admin settings.)
AUTH_SECRET=

# Admins as user:password pairs, comma separated. Usernames ignore case.
# (ADMIN_USERNAME + ADMIN_PASSWORD also work for a single admin.)
ADMIN_USERS=rabbi:change-me,gabbai:change-me-too

# Upstash Redis (Vercel > Storage > Upstash). Without these, times are
# saved to data/times.json, which only works when running locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
